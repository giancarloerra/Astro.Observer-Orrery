{
  "_meta": {
    "description": "IAU WGCCRE rotational elements (north pole direction alpha0/delta0 and prime meridian W) for the Sun, planets and selected satellites, transcribed from the four source documents listed below. alpha0 and delta0 are ICRF equatorial coordinates at epoch J2000.0 (WGCCRE 2015 report, Table 1 header, p. 8 of 46).",
    "standard_epoch": "JD 2451545.0, i.e. 2000 January 1 12 h TDB (WGCCRE 2015 report, Table 1 header, p. 8 of 46)",
    "time_variables": {
      "T": "Interval in Julian centuries (36,525 days) from the standard epoch (WGCCRE 2015 report, Table 1 header, p. 8 of 46)",
      "d": "Interval in days from the standard epoch (WGCCRE 2015 report, Table 1 header, p. 8 of 46)"
    },
    "conventions": {
      "digits": "Every numeric value is a string preserving the exact digits printed by its source, including trailing zeros. Parse to float in the app.",
      "units": "All constants and coefficients are degrees. wdot_deg_per_day is degrees per day of d. T_terms entries are {power, coeff}: coeff multiplies T to that power (T in Julian centuries).",
      "trig_terms": "Entries are {coeff, fn, arg} and optionally arg_multiple: the term is coeff times fn(arg_multiple x arg). arg_multiple absent means 1. arg names refer to the top-level arguments object.",
      "d_terms": "Entries are {power, coeff}: coeff multiplies d to that power (d in days from the standard epoch). Present only where the source prints a polynomial term in d beyond the linear wdot_deg_per_day term (the Moon's W in the WGCCRE2009 report). coeff_as_printed records the source's power-of-ten notation where the machine-parseable coeff differs from it.",
      "nulls": "pole_ra, pole_dec and W set to null mean the source documents publish no closed-form rotational elements for that body; the entry's note says what the source says instead."
    },
    "sources": {
      "WGCCRE2015": "Archinal, B.A., et al., Report of the IAU Working Group on Cartographic Coordinates and Rotational Elements: 2015, Celestial Mechanics and Dynamical Astronomy 130:22 (2018), DOI 10.1007/s10569-017-9805-5. Page numbers cited are the 'Page N of 46' numbers printed on the publisher reprint.",
      "Correction2019": "Archinal, B.A., et al., Correction to: Report of the IAU Working Group on Cartographic Coordinates and Rotational Elements: 2015, Celestial Mechanics and Dynamical Astronomy 131:61 (2019), DOI 10.1007/s10569-019-9925-1.",
      "PSIDA2018": "Archinal, B. and the IAU WGCCRE, Planetary Coordinates Recommendations from the IAU Working Group on Cartographic Coordinates and Rotational Elements, Planetary Science Informatics and Data Analytics Conference, St. Louis, 2018 April 26. A slide deck; page numbers cited are PDF page numbers.",
      "WGCCRE2009": "Archinal, B.A., et al., Report of the IAU Working Group on Cartographic Coordinates and Rotational Elements: 2009, Celestial Mechanics and Dynamical Astronomy 109:101-135 (2011), DOI 10.1007/s10569-010-9320-4. Page numbers cited are the printed journal page numbers 101-135."
    }
  },
